#!/usr/bin/env bash
# ComfyInventory command-line interface.
#
# Each workflow folder contains a clean workflow.json, a pinned manifest.json,
# and a thin install.sh wrapper that invokes this CLI.
set -Eeuo pipefail
# Report commands should exit cleanly when piped into `head`/`less`.
trap '' PIPE

CI_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export CI_ROOT

# Allow --no-color / --color to influence the colour setup in common.sh,
# which is sourced before the main option parser runs.
for _arg in "$@"; do
  case "$_arg" in
    --no-color) export CI_COLOR=never ;;
    --color)    export CI_COLOR=always ;;
  esac
done
unset _arg

# shellcheck source=../lib/common.sh
source "$CI_ROOT/lib/common.sh"
# shellcheck source=../lib/installer.sh
source "$CI_ROOT/lib/installer.sh"

VERSION="1.0.0"

usage() {
  cat <<'EOF' 2>/dev/null || true
ComfyInventory - reproducible per-workflow installers for ComfyUI

Usage:
  comfy-inventory <command> [options] [workflow-id ...]

Commands:
  list                    List available workflows and recipes
  status [id ...]         Show which files are installed (default: all)
  install <id ...>        Install one or more workflows or recipes
  verify [id ...]         Verify installed files against pinned SHA-256
  doctor                  Check dependencies, paths, token and disk space
  version                 Print the version

Options:
  --comfy-dir PATH        ComfyUI root (default: $COMFY_DIR or ~/opt/ComfyUI)
  --staging-dir PATH      Partial-download cache
                          (default: <comfy-dir>/.cache/comfy-inventory)
  --manifest PATH         Install/check a specific manifest.json (bypasses IDs)
  --all                   Select every workflow and recipe
  --force                 Re-download every model, even if present
  --repair                Replace only missing files and checksum/size mismatches
  --verify                SHA-256 existing files while planning
  --dry-run               Show what would happen without changing anything
  --jobs N                Concurrent downloads (default: 4)
  --downloader MODE       auto, aria2c, or curl (default: auto)
  --no-workflow           Do not copy the workflow JSON into ComfyUI
  --force-workflow        Overwrite a differing installed workflow (keeps a backup)
  --workflow-only         Install only the workflow JSON, not models
  --skip-space-check      Do not check free disk space before downloading
  --skip-auth-check       Do not preflight gated Hugging Face access
  --quiet, -q             Less output
  --verbose, -v           More output
  --no-color              Disable ANSI colours
  --color                 Force ANSI colours
  -h, --help              Show this help
  --version               Show the version

Examples:
  ./comfy-inventory list
  ./comfy-inventory status z-image-t2i
  ./comfy-inventory install z-image-t2i
  ./comfy-inventory install --all --dry-run
  ./workflows/z-image-t2i/install.sh

Environment:
  COMFY_DIR               ComfyUI root (same as --comfy-dir)
  COMFY_STAGE_DIR         Partial-download cache (same as --staging-dir)
  HF_TOKEN                Hugging Face token for gated repositories
  MAX_JOBS                Default concurrency (same as --jobs)
  NO_COLOR                Disable colours
EOF
}

# ---------------------------------------------------------------------------
# Defaults and option parsing
# ---------------------------------------------------------------------------
CI_COMFY_DIR="${COMFY_DIR:-$HOME/opt/ComfyUI}"
CI_STAGE_ROOT="${COMFY_STAGE_DIR:-}"
CI_JOBS="${MAX_JOBS:-4}"
CI_DOWNLOADER="${CI_DOWNLOADER:-auto}"

CI_FORCE=0
CI_REPAIR=0
CI_VERIFY=0
CI_DRY_RUN=0
CI_NO_WORKFLOW=0
CI_FORCE_WORKFLOW=0
CI_WORKFLOW_ONLY=0
CI_SKIP_SPACE_CHECK=0
CI_SKIP_AUTH_CHECK=0
CI_QUIET=0
CI_VERBOSE=0
CI_ALL=0
CI_MANIFEST=""

POSITIONAL=()

while (( $# > 0 )); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --version) printf 'comfy-inventory %s\n' "$VERSION"; exit 0 ;;
    --comfy-dir)
      [[ $# -ge 2 ]] || die "--comfy-dir requires a path"
      CI_COMFY_DIR="$2"; shift 2 ;;
    --staging-dir)
      [[ $# -ge 2 ]] || die "--staging-dir requires a path"
      CI_STAGE_ROOT="$2"; shift 2 ;;
    --manifest)
      [[ $# -ge 2 ]] || die "--manifest requires a path"
      CI_MANIFEST="$2"; shift 2 ;;
    --jobs|-j)
      [[ $# -ge 2 ]] || die "--jobs requires a number"
      CI_JOBS="$2"; shift 2 ;;
    --downloader)
      [[ $# -ge 2 ]] || die "--downloader requires auto, aria2c, or curl"
      CI_DOWNLOADER="$2"; shift 2 ;;
    --all) CI_ALL=1; shift ;;
    --force) CI_FORCE=1; shift ;;
    --repair) CI_REPAIR=1; shift ;;
    --verify) CI_VERIFY=1; shift ;;
    --dry-run) CI_DRY_RUN=1; shift ;;
    --no-workflow) CI_NO_WORKFLOW=1; shift ;;
    --force-workflow) CI_FORCE_WORKFLOW=1; shift ;;
    --workflow-only) CI_WORKFLOW_ONLY=1; shift ;;
    --skip-space-check) CI_SKIP_SPACE_CHECK=1; shift ;;
    --skip-auth-check) CI_SKIP_AUTH_CHECK=1; shift ;;
    --quiet|-q) CI_QUIET=1; shift ;;
    --verbose|-v) CI_VERBOSE=1; CI_DEBUG=1; shift ;;
    --no-color|--color) shift ;;
    --)
      shift
      while (( $# > 0 )); do POSITIONAL+=("$1"); shift; done
      break ;;
    -*)
      die "unknown option: $1 (try --help)" ;;
    *)
      POSITIONAL+=("$1"); shift ;;
  esac
done

CI_COMFY_DIR="$(abspath "$CI_COMFY_DIR")"
if [[ -z "$CI_STAGE_ROOT" ]]; then
  CI_STAGE_ROOT="$CI_COMFY_DIR/.cache/comfy-inventory"
fi
CI_STAGE_ROOT="$(abspath "$CI_STAGE_ROOT")"

[[ "$CI_JOBS" =~ ^[1-9][0-9]*$ ]] || die "--jobs must be a positive integer"
[[ "$CI_DOWNLOADER" == "auto" || "$CI_DOWNLOADER" == "aria2c" || "$CI_DOWNLOADER" == "curl" ]] \
  || die "--downloader must be one of: auto, aria2c, curl"
[[ "$CI_NO_WORKFLOW" == "0" || "$CI_WORKFLOW_ONLY" == "0" ]] \
  || die "--no-workflow and --workflow-only are mutually exclusive"

CMD="${POSITIONAL[0]:-}"
TARGETS=("${POSITIONAL[@]:1}")

if [[ -z "$CMD" ]]; then
  usage
  exit 1
fi

if [[ "$CMD" == "help" ]]; then
  usage
  exit 0
fi

if [[ "$CI_ALL" == "1" && ${#TARGETS[@]} -gt 0 ]]; then
  die "--all cannot be combined with workflow IDs"
fi
if [[ -n "$CI_MANIFEST" && "$CI_ALL" == "1" ]]; then
  die "--manifest cannot be combined with --all"
fi
if [[ -n "$CI_MANIFEST" && ${#TARGETS[@]} -gt 0 ]]; then
  die "--manifest cannot be combined with workflow IDs"
fi

# ---------------------------------------------------------------------------
# Manifest discovery
# ---------------------------------------------------------------------------
find_manifests() {
  find "$CI_ROOT/workflows" -mindepth 2 -maxdepth 2 -name manifest.json -print 2>/dev/null | sort || true
  find "$CI_ROOT/recipes" -mindepth 2 -maxdepth 2 -name manifest.json -print 2>/dev/null | sort || true
}

manifest_for_target() {
  local target="$1" base candidate
  if [[ -f "$target" && "$(basename -- "$target")" == "manifest.json" ]]; then
    printf '%s' "$(abspath "$target")"
    return 0
  fi
  if [[ -d "$target" && -f "$target/manifest.json" ]]; then
    printf '%s' "$(abspath "$target/manifest.json")"
    return 0
  fi
  for base in workflows recipes; do
    candidate="$CI_ROOT/$base/$target/manifest.json"
    if [[ -f "$candidate" ]]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

RESOLVED_MANIFESTS=()

resolve_manifests() {
  RESOLVED_MANIFESTS=()
  local -a resolved=()
  local -A seen=()
  local m t

  if [[ -n "$CI_MANIFEST" ]]; then
    m="$(abspath "$CI_MANIFEST")"
    [[ -f "$m" ]] || { err "manifest not found: $m"; return 1; }
    RESOLVED_MANIFESTS=("$m")
    return 0
  fi

  if [[ "$CI_ALL" == "1" ]]; then
    while IFS= read -r m; do
      [[ -n "$m" ]] || continue
      resolved+=("$m")
    done < <(find_manifests)
  else
    for t in "${TARGETS[@]}"; do
      if ! m="$(manifest_for_target "$t")"; then
        err "unknown workflow '$t'. Run './comfy-inventory list' to see available IDs."
        return 1
      fi
      resolved+=("$m")
    done
  fi

  if (( ${#resolved[@]} == 0 )); then
    err "no workflows selected. Pass an ID, --all, or --manifest."
    return 1
  fi

  for m in "${resolved[@]}"; do
    if [[ -z "${seen[$m]:-}" ]]; then
      seen[$m]=1
      RESOLVED_MANIFESTS+=("$m")
    fi
  done
  return 0
}

# ---------------------------------------------------------------------------
# list
# ---------------------------------------------------------------------------
cmd_list() {
  local m id kind name count total
  outf '%-30s %-9s %7s %10s  %s\n' "ID" "KIND" "MODELS" "SIZE" "NAME"
  outf '%-30s %-9s %7s %10s  %s\n' "------------------------------" "---------" "-------" "----------" "----"
  while IFS= read -r m; do
    [[ -n "$m" ]] || continue
    id="$(jq -r '.id // "?"' "$m")"
    name="$(jq -r '.name // ""' "$m")"
    kind="$(basename -- "$(dirname -- "$(dirname -- "$m")")")"
    kind="${kind%s}"
    count="$(jq -r '.models | length' "$m")"
    total="$(jq -r '[.models[].size] | add // 0' "$m")"
    outf '%-30s %-9s %7s %10s  %s\n' "$id" "$kind" "$count" "$(human_size "$total")" "$name"
  done < <(find_manifests)
}

# ---------------------------------------------------------------------------
# status / verify / install / doctor
# ---------------------------------------------------------------------------
selection_is_all() {
  if [[ -z "$CI_MANIFEST" && "$CI_ALL" == "0" && ${#TARGETS[@]} -eq 0 ]]; then
    CI_ALL=1
  fi
}

cmd_status() {
  selection_is_all
  resolve_manifests || return 1
  local m rc=0 failed=0
  for m in "${RESOLVED_MANIFESTS[@]}"; do
    set +e
    ( status_manifest "$m" )
    rc=$?
    set -e
    (( rc == 0 )) || failed=$((failed + 1))
  done

  if (( failed > 0 )); then
    info ""
    err "$failed workflow(s) are not fully installed."
    return 1
  fi
  info ""
  ok "All selected workflows are fully installed."
}

cmd_verify() {
  selection_is_all
  resolve_manifests || return 1
  local m rc=0 failed=0
  for m in "${RESOLVED_MANIFESTS[@]}"; do
    set +e
    ( verify_manifest "$m" )
    rc=$?
    set -e
    (( rc == 0 )) || failed=$((failed + 1))
  done

  if (( failed > 0 )); then
    err "$failed workflow(s) failed verification."
    return 1
  fi
  ok "All selected files verified."
}

cmd_install() {
  resolve_manifests || return 1
  local m rc=0 failed=0
  ci_lock "$CI_ROOT/.state"

  for m in "${RESOLVED_MANIFESTS[@]}"; do
    set +e
    ( install_manifest "$m" )
    rc=$?
    set -e
    (( rc == 0 )) || failed=$((failed + 1))
  done

  if (( failed > 0 )); then
    err "$failed workflow(s) failed to install."
    return 1
  fi
  return 0
}

cmd_doctor() {
  local rc=0

  info "ComfyInventory $VERSION"
  info "Root:        $CI_ROOT"
  info "ComfyUI:     $CI_COMFY_DIR"
  info "Staging:     $CI_STAGE_ROOT"
  info "Manifests:   $(find_manifests | wc -l)"
  info ""

  info "Dependencies:"
  local cmd
  for cmd in jq curl awk df find sed; do
    if have "$cmd"; then
      ok "  $cmd: $(command -v "$cmd")"
    else
      err "  $cmd: missing (required)"
      rc=1
    fi
  done
  if have sha256sum || have shasum; then
    ok "  sha256: $(command -v sha256sum 2>/dev/null || command -v shasum)"
  else
    err "  sha256sum/shasum: missing (one is required)"
    rc=1
  fi
  if have aria2c; then
    ok "  aria2c: $(command -v aria2c) (preferred downloader)"
  else
    warn "  aria2c: missing (curl fallback will be used)"
  fi
  if have flock; then
    ok "  flock: $(command -v flock)"
  else
    warn "  flock: missing (mkdir lock fallback will be used)"
  fi

  info ""
  info "Paths:"
  if [[ -d "$CI_COMFY_DIR" ]]; then
    ok "  ComfyUI directory exists"
  else
    err "  ComfyUI directory does not exist: $CI_COMFY_DIR"
    rc=1
  fi
  if [[ -d "$CI_COMFY_DIR/user/default/workflows" ]]; then
    ok "  workflow directory exists"
  else
    warn "  workflow directory missing (will be created on install)"
  fi
  if [[ -w "$CI_COMFY_DIR" ]]; then
    ok "  ComfyUI directory is writable"
  else
    err "  ComfyUI directory is not writable"
    rc=1
  fi

  info ""
  info "Hugging Face token:"
  local token
  token="$(discover_hf_token)"
  if [[ -n "$token" ]]; then
    ok "  token found (${#token} characters; value not shown)"
  else
    warn "  no token found; public models still work, gated models will fail"
  fi

  info ""
  info "Disk:"
  local free
  free="$(free_bytes "$CI_COMFY_DIR" 2>/dev/null || true)"
  if [[ -n "$free" ]]; then
    info "  free in ComfyUI filesystem: $(human_size "$free")"
  else
    warn "  could not determine free space"
  fi

  info ""
  if (( rc == 0 )); then
    ok "Doctor check passed."
  else
    err "Doctor check found problems."
  fi
  return $rc
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
case "$CMD" in
  list)
    [[ -z "$CI_MANIFEST" ]] || die "list does not take --manifest"
    require jq
    cmd_list
    ;;
  status)
    require jq
    have sha256sum || have shasum || die "sha256sum or shasum is required"
    cmd_status
    ;;
  verify)
    require jq
    have sha256sum || have shasum || die "sha256sum or shasum is required"
    cmd_verify
    ;;
  install)
    require jq
    require curl
    have sha256sum || have shasum || die "sha256sum or shasum is required"
    cmd_install
    ;;
  doctor)  cmd_doctor ;;
  version) printf 'comfy-inventory %s\n' "$VERSION" ;;
  *)
    usage
    exit 1
    ;;
esac
